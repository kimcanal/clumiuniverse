/*
  Cache-Control: public, max-age=0, must-revalidate
  Netlify-CDN-Cache-Control: public, max-age=60, stale-while-revalidate=300

/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Netlify-CDN-Cache-Control: public, max-age=31536000

/data/tossplace-menu/*/images/*
  Cache-Control: public, max-age=31536000, immutable
  Netlify-CDN-Cache-Control: public, durable, max-age=31536000

/data/*.json
  Cache-Control: public, max-age=0, must-revalidate
  Netlify-CDN-Cache-Control: public, max-age=300, stale-while-revalidate=3600

/data/tossplace-menu/*/*.json
  Cache-Control: public, max-age=0, must-revalidate
  Netlify-CDN-Cache-Control: public, max-age=300, stale-while-revalidate=3600
